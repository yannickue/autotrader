# Local-only configuration for the ActivTrades/MT5 CFD adapter.
#
# Copy this file to `.env` and fill in real values there. `.env` is
# git-ignored (see .gitignore) -- never commit real credentials. This file
# itself must only ever contain placeholders.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
